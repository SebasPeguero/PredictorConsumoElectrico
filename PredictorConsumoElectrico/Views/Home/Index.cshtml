@model PredictorConsumoElectrico.Core.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Pronóstico de Energía";
}

<div class="container py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 bg-surface-container-low overflow-hidden">
                <div class="row g-0 align-items-center">
                    <div class="col-md-8 p-5">
                        <h1 class="display-5 font-headline-lg font-bold text-on-surface mb-3"> Pronóstico Inteligente de Energía </h1>
                        <p class="lead text-on-surface-variant font-body-md mb-0"> Ingrese el historial de consumo eléctrico de los últimos 12 meses de su hogar. Nuestro modelo analítico procesará los datos para proporcionar una predicción precisa del requerimiento energético para el próximo ciclo. </p>
                    </div>
                    <div class="col-md-4 bg-primary-container d-none d-md-flex align-items-center justify-content-center p-5">
                        <div class="text-primary opacity-25">
                            <span class="material-symbols-rounded" style="font-size: 160px;">bolt</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.HayResultado)
    {
        <div class="row justify-content-center mb-5 anim-fade-in">
            <div class="col-lg-10">
                <div class="card border-primary border-top-width-4 shadow rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                            <div>
                                <h2 class="h4 font-headline-sm text-on-surface mb-1">Proyección Calculada</h2>
                                <p class="text-on-surface-variant font-body-sm mb-0">Estimación para el próximo período</p>
                            </div>
                            <span class="badge rounded-pill bg-primary px-3 py-2 font-label-md"> @Model.NombreMetodoSeleccionado </span>
                        </div>
                        <div class="row align-items-center g-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-baseline">
                                    <span class="display-3 font-headline-lg font-bold text-on-surface">@Model.ConsumoProximoMes?.ToString("N2")</span>
                                    <span class="h3 font-headline-md text-on-surface-variant ms-2 fw-normal">kWh</span>
                                </div>
                                @{
                                    var tendenciaClass = Model.tendencia != null && Model.tendencia.Contains("Estable") ? "bg-success-container text-success" : Model.tendencia != null && Model.tendencia.Contains("Alcista") ? "bg-error-container text-error" : "bg-secondary-container text-secondary";
                                    var tendenciaIcon = Model.tendencia != null && Model.tendencia.Contains("Estable") ? "trending_flat" : Model.tendencia != null && Model.tendencia.Contains("Alcista") ? "trending_up" : "trending_down";
                                }
                                <div class="d-inline-flex align-items-center mt-3 @tendenciaClass px-3 py-2 rounded-2">
                                    <span class="material-symbols-rounded me-2">@tendenciaIcon</span>
                                    <span class="font-label-lg fw-semibold">@Model.tendencia</span>
                                </div>
                            </div>
                            <div class="col-md-6 border-start-md border-outline-variant ps-md-4">
                                <div class="card bg-surface-container-lowest border-outline-variant rounded-3 h-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center gap-2 mb-2 text-on-surface">
                                            <span class="material-symbols-rounded fs-5">info</span>
                                            <span class="font-label-md fw-bold">Detalle del Análisis</span>
                                        </div>
                                        <div class="bg-surface-container p-3 rounded-2">
                                            <pre class="mb-0 font-code-sm text-on-surface-variant overflow-auto" style="max-height: 150px; white-space: pre-wrap;">@Model.MensajeDetallado</pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-12">
            <h3 class="font-headline-sm text-on-surface mb-2 px-3">Datos Históricos</h3>
            <p class="text-on-surface-variant font-body-sm mb-4 px-3">Registre los valores correspondientes a los 12 meses previos.</p>
            
            <form asp-action="Index" method="post" class="needs-validation">
                <div class="row g-4">
                    @for (int i = 0; i < 12; i++)
                    {
                        <div class="col-sm-6 col-md-4 col-xl-3">
                            <div class="card border-outline-variant shadow-sm h-100 rounded-3">
                                <div class="card-header bg-transparent border-bottom border-outline-variant py-2 d-flex justify-content-between align-items-center">
                                    <span class="font-label-md fw-bold text-on-surface-variant">Mes @(i + 1)</span>
                                    <span class="material-symbols-rounded text-outline fs-5">calendar_month</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="mb-3">
                                        <label asp-for="Registros[i].Fecha" class="form-label font-label-sm text-on-surface-variant mb-1">Fecha de Facturación</label>
                                        <input asp-for="Registros[i].Fecha" type="date" class="form-control form-control-md border-outline-variant rounded-2" />
                                        <span asp-validation-for="Registros[i].Fecha" class="text-danger font-caption mt-1 d-block"></span>
                                    </div>
                                    <div class="mb-0">
                                        <label asp-for="Registros[i].Valor" class="form-label font-label-sm text-on-surface-variant mb-1">Consumo</label>
                                        <div class="input-group">
                                            <input asp-for="Registros[i].Valor" type="number" step="0.01" class="form-control form-control-md border-outline-variant rounded-start-2" placeholder="0.00" />
                                            <span class="input-group-text bg-surface-container-low border-outline-variant text-on-surface-variant font-label-sm rounded-end-2 px-3">kWh</span>
                                        </div>
                                        <span asp-validation-for="Registros[i].Valor" class="text-danger font-caption mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-center mt-5 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg px-5 py-3 rounded-3 shadow hover-lift d-inline-flex align-items-center gap-2">
                        <span class="material-symbols-rounded">analytics</span>
                        <span class="fw-bold">Calcular predicción</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>

    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; }
    .anim-fade-in { animation: fadeIn 0.6s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .border-top-width-4 { border-top-width: 4px !important; }
    @@media (min-width: 768px) { .border-start-md { border-left: 1px solid var(--bs-border-color) !important; } }
</style>

    @section Scripts {
    <script>
        $(document).ready(function () {
            // Interceptar la tecla presionada en los inputs numéricos y de fecha
            $('form input').keydown(function (e) {
                // El código 13 es la tecla Enter
                if (e.keyCode == 13) {
                    e.preventDefault(); // Detenemos el envío del formulario
                    
                    // Buscamos todos los inputs visibles en el formulario
                    var inputs = $(this).closest('form').find(':input:visible');
                    // Encontramos el índice del input actual y le sumamos 1
                    var nextInput = inputs.eq(inputs.index(this) + 1);
                    
                    // Si existe un siguiente input, le hacemos focus
                    if (nextInput.length) {
                        nextInput.focus();
                    } else {
                        // Si es el último input de todos, entonces sí enviamos el formulario
                        $(this).closest('form').submit();
                    }
                }
            });
        });
    </script>
}