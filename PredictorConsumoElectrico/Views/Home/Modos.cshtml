@model PredictorConsumoElectrico.Infrastructure.PredictionSettings
@{
    ViewData["Title"] = "Configuración de Modos";
}

<div class="row justify-content-center w-100">
    <div class="col-md-7 col-lg-5">
        
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <span class="material-symbols-rounded align-middle me-2">check_circle</span>
                @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border shadow-sm rounded-4" style="border-color: #e0e4ec !important;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 mb-3 rounded-3" style="background-color: #e8effd; color: #005ac1;">
                        <span class="material-symbols-rounded" style="font-size: 28px;">settings_suggest</span>
                    </div>
                    <h2 class="h4 fw-bold text-dark mb-3">Configuración de Algoritmos</h2>
                    <p class="text-muted mb-4" style="font-size: 0.95rem;">Seleccione el método de cálculo que desea aplicar para las previsiones energéticas de su sistema.</p>
                </div>

                <form asp-action="Modos" method="post">
                    <div class="mb-4 text-start">
                        <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Método de Predicción</label>
                        <select name="ModoSeleccionado" class="form-select form-select-lg" style="border-color: #ced4da; font-size: 1rem; color: #212529;" required>
                            <option value="SMA" selected="@(Model.ModoSeleccionado == "SMA")">Promedio Móvil Simple (SMA)</option>
                            <option value="RegresionLineal" selected="@(Model.ModoSeleccionado == "RegresionLineal")">Regresión Lineal</option>
                            <option value="VariacionPorcentual" selected="@(Model.ModoSeleccionado == "VariacionPorcentual")">Variación Porcentual</option>
                            <option value="Tendencia" selected="@(Model.ModoSeleccionado == "Tendencia")">Detección de Tendencia</option>
                        </select>
                    </div>

                    <div class="alert border-0 rounded-3 d-flex p-3 mb-4" style="background-color: #f0f4ff;">
                        <span class="material-symbols-rounded text-primary me-3 mt-1" style="font-size: 24px;">info</span>
                        <div>
                            <span class="d-block fw-bold text-dark" style="font-size: 0.9rem;">Impacto de la Selección</span>
                            <span class="d-block text-muted" style="font-size: 0.85rem;">Los algoritmos complejos como 'Regresión Lineal' pueden requerir más datos históricos para ofrecer una precisión óptima en comparación con el 'Promedio Móvil'.</span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-dark btn-lg fw-bold rounded-3 py-3 d-flex justify-content-center align-items-center">
                            <span class="material-symbols-rounded me-2">save</span> Guardar Configuración
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>